# Required
# Postgres connection string — the single source of truth for every table.
DATABASE_URL=postgresql://localhost:5432/meridian

# Auth signing secret; generate once with `openssl rand -base64 32` and keep.
BETTER_AUTH_SECRET=

# Optional: explicit public base URL for the auth endpoints. When unset,
# better-auth derives it from each request's Host header, which is fine for
# local and single-host deploys.
BETTER_AUTH_URL=

# Dev-only escape hatch (default false). When true, requireSession() passes
# every request through with a synthetic global_admin actor and no DB or auth
# is exercised. For UI iteration only — never alongside a reachable database
# in a real deployment.
AUTH_PASSTHROUGH=

# Optional outbound email for the OTP verification code. When SMTP_HOST is
# unset the verification email is printed to the server console instead —
# sufficient on this network, where external SMTP is unreachable.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=